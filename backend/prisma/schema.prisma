datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FoodAvailability {
  AVAILABLE
  UNAVAILABLE
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  fullName            String
  role                UserRole       @default(CUSTOMER)
  phoneNumber         String?
  preferredLocationId String?
  preferredLocation   Location?      @relation("CustomerPreferredLocation", fields: [preferredLocationId], references: [id], onDelete: SetNull)
  provider            Provider?
  orders              Order[]        @relation("CustomerOrders")
  notifications       Notification[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([email])
  @@index([role])
}

model Provider {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        ProviderStatus @default(PENDING)
  counterNumber String?
  locationId    String
  location      Location       @relation("LocationProviders", fields: [locationId], references: [id], onDelete: Restrict)
  isOpen        Boolean        @default(true)
  prepBufferMin Int            @default(0)
  rating        Decimal        @default(4.5) @db.Decimal(3, 2)
  reviewCount   Int            @default(0)
  foodItems     FoodItem[]
  orders        Order[]        @relation("ProviderOrders")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([locationId])
  @@index([status])
}

model Location {
  id             String     @id @default(uuid())
  name           String     @unique
  code           String?    @unique
  description    String?
  hallName       String?
  crowdStatus    String     @default("Normal")
  avgPrepTimeMin Int        @default(10)
  isActive       Boolean    @default(true)
  providers      Provider[] @relation("LocationProviders")
  customers      User[]     @relation("CustomerPreferredLocation")
  orders         Order[]    @relation("LocationOrders")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  foodItems   FoodItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FoodItem {
  id           String           @id @default(uuid())
  providerId   String
  provider     Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  price        Decimal          @db.Decimal(10, 2)
  imageUrl     String?
  availability FoodAvailability @default(AVAILABLE)
  isVeg        Boolean          @default(false)
  isVegan      Boolean          @default(false)
  isHalal      Boolean          @default(false)
  isGlutenFree Boolean          @default(false)
  calories     Int?
  prepTimeMin  Int              @default(10)
  prepTimeMax  Int              @default(15)
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([providerId])
  @@index([categoryId])
  @@index([availability])
}

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  customerId       String
  customer         User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  providerId       String
  provider         Provider       @relation("ProviderOrders", fields: [providerId], references: [id], onDelete: Restrict)
  locationId       String
  location         Location       @relation("LocationOrders", fields: [locationId], references: [id], onDelete: Restrict)
  status           OrderStatus    @default(PLACED)
  pickupPreference String         @default("ASAP")
  diningType       String         @default("Takeaway")
  scheduledReadyAt DateTime?
  subtotal         Decimal        @db.Decimal(10, 2)
  tax              Decimal        @default(0.00) @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0.00) @db.Decimal(10, 2)
  discount         Decimal        @default(0.00) @db.Decimal(10, 2)
  totalAmount      Decimal        @db.Decimal(10, 2)
  notes            String?
  items            OrderItem[]
  payment          Payment?
  notifications    Notification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId          String
  foodItem            FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  itemName            String
  price               Decimal  @db.Decimal(10, 2)
  quantity            Int      @default(1)
  specialInstructions String?
  createdAt           DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  paymentMethod      String        @default("UPI")
  gateway            String        @default("CASHFREE")
  gatewayOrderId     String?
  gatewayPaymentId   String?
  cfPaymentSessionId String?
  transactionId      String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([gatewayOrderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("ORDER_UPDATE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}
